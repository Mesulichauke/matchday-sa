# API configuration (server-only; do not expose these as VITE_ variables)
PORT=3001
DATABASE_PATH=./server/matchday.sqlite
APP_ORIGIN=http://localhost:5500
NODE_ENV=development
VITE_API_BASE_URL=
COOKIE_SAMESITE=lax

# Required for first administrator bootstrap. Change these before starting the API.
# The account is created only if the email does not already exist.
ADMIN_NAME=Matchday Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
